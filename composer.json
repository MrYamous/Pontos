{
    "name": "yamous/inspect-database-bundle",
    "description": "A Symfony bundle to inspect database",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "symfony/console": "^7.0",
        "doctrine/dbal": "^3.0",
        "symfony/http-kernel": "^7.0",
        "symfony/dependency-injection": "^7.0"
    },
    "autoload": {
        "psr-4": { 
            "Yamous\\InspectDatabaseBundle\\": "src/" 
        }
    },
    "require-dev": {
        "symfony/framework-bundle": "^7.3",
        "phpunit/phpunit": "^12.3",
        "doctrine/doctrine-bundle": "^2.16",
        "symfony/yaml": "^7.3",
        "doctrine/orm": "^3.5"
    },
    "autoload-dev": {
        "psr-4": { 
            "Yamous\\InspectDatabaseBundle\\Tests\\": "tests/" 
        }
    }
}
